<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>com.example.gateway</groupId>
  <artifactId>container-gateway</artifactId>
  <version>1.0.0</version>
  <name>container-gateway</name>
  <description>受控 Docker 容器生命周期 REST 网关</description>

  <properties>
    <java.version>21</java.version>
    <docker-java.version>3.4.1</docker-java.version>
  </properties>

  <!--
    漏洞修复（方案A）——覆盖 docker-java 3.4.1 传入的老依赖，保持 docker-java 版本不变。

    低风险批次（2026-10-16）：
      - jackson-databind 2.21.1 -> 2.21.5（docker-java-core 传递依赖，Jackson 2）
      - commons-io 2.13.0 -> 2.14.0（docker-java-core 传递依赖）
      Jackson 3（tools.jackson）与 log4j-api 由 spring-boot-dependencies 4.0.8 统一管理
      （分别为 3.1.5 / 2.25.5），无需在此显式固定。

    高风险批次（2026-10-16）——高回归成本，已单独构建 + 专项回归：
      - commons-compress 1.21 -> 1.26.0（文件收发 API 的 tar 底层）
      - guava 19.0 -> 32.0.0-jre（docker-java 内部）
      - bcpkix/bcprov/bcutil-jdk18on 1.76 -> 1.85（docker-java 多节点 TLS）

    未覆盖（无法用 dependencyManagement 覆盖）：docker-java-transport-zerodep 内嵌着色的
    httpclient5 5.0.3 / httpcore5 5.0.2 / httpcore5-h2 5.0.2，需等 docker-java 升级。
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>2.21.5</version>
      </dependency>
      <dependency>
        <groupId>commons-io</groupId>
        <artifactId>commons-io</artifactId>
        <version>2.14.0</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-compress</artifactId>
        <version>1.26.0</version>
      </dependency>
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>32.0.0-jre</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>1.85</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcpkix-jdk18on</artifactId>
        <version>1.85</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcutil-jdk18on</artifactId>
        <version>1.85</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>com.github.docker-java</groupId>
      <artifactId>docker-java-core</artifactId>
      <version>${docker-java.version}</version>
    </dependency>
    <!-- unix:///var/run/docker.sock 支持在 transport 实现里，必须显式引入 zerodep -->
    <dependency>
      <groupId>com.github.docker-java</groupId>
      <artifactId>docker-java-transport-zerodep</artifactId>
      <version>${docker-java.version}</version>
    </dependency>

    <!--
      高风险批次连带修复：commons-compress 1.26.0 把 commons-codec 声明为 optional，
      而 TarArchiveOutputStream 调用 org.apache.commons.codec.Charsets.toCharset（tar 写入路径，
      文件上传 / docker-java copyArchiveToContainer 会走到）。optional 依赖不传递，必须显式引入，
      否则运行期 NoClassDefFoundError。版本对齐 commons-compress 1.26.0 自身配对版本。
    -->
    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
      <version>1.16.1</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>container-gateway</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
