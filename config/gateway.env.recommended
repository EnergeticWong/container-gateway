# container-gateway 参数基线（容量 / 限流）
# ---------------------------------------------------------------------------
# 用途：install.sh 在安装或刷新时，逐项比对 /etc/container-gateway.env，与基线不一致只告警，
#      不会自动修改你的配置。用于提醒「这台机器还没跟上压测结论」。
# 依据：2026-11-04 双节点压测结论（docs/reports/loadtest-2026-11-04-node-pool.md）
# 标定条件：网关节点 8C/31G + 1 个远程节点（每节点 200 流、连接池 600，400 条并发 SSE 全通）
# 调整：节点规格不同（尤其是 CPU 更少或 dockerd 更弱）时，请评估后改本文件，不要直接照搬。
# ---------------------------------------------------------------------------
GATEWAY_NODE_MAX_TASKS=30
GATEWAY_MAX_STREAMS_PER_NODE=200
GATEWAY_DOCKER_MAX_CONNECTIONS=600
MAX_CONTAINERS=1000
MAX_PER_OWNER=1000
RATE_LIMIT_PER_MINUTE=60000
CREATE_RATE_LIMIT_PER_MINUTE=600
